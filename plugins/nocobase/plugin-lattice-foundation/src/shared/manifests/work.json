{
  "schemaVersion": 1,
  "id": "work",
  "name": "Công việc của tôi",
  "route": "/lattice/apps/work",
  "permissions": [
    "workflow:start"
  ],
  "collections": [
    {
      "id": "workflow-runs",
      "source": "lattice-api",
      "resource": "workflows"
    }
  ],
  "blocks": [
    {
      "id": "my-inbox",
      "type": "task-inbox",
      "title": "Công việc của tôi",
      "collection": "workflow-runs",
      "permissions": [
        "workflow:start"
      ],
      "pageSize": 10,
      "approvalBlockId": "request-approval"
    },
    {
      "id": "request-approval",
      "type": "approval",
      "title": "Chi tiết và xử lý công việc",
      "collection": "workflow-runs",
      "permissions": [
        "workflow:start"
      ],
      "actionLabels": {
        "approve": "Duyệt",
        "reject": "Từ chối",
        "submit": "Gửi yêu cầu"
      },
      "fieldLabels": {
        "reason": "Lý do từ chối"
      },
      "attachmentBlockId": "request-files",
      "timelineBlockId": "request-history",
      "contextBlockId": "request-context"
    },
    {
      "id": "request-files",
      "type": "attachment",
      "title": "Tệp đính kèm",
      "collection": "workflow-runs",
      "permissions": [
        "files:read"
      ],
      "allowUpload": true,
      "fileFields": [
        "attachmentId",
        "receiptAttachmentId"
      ]
    },
    {
      "id": "request-history",
      "type": "activity-timeline",
      "title": "Lịch sử xử lý",
      "collection": "workflow-runs",
      "permissions": [
        "workflow:start"
      ],
      "pageSize": 10,
      "actionLabels": {
        "create": "Tạo yêu cầu",
        "submit": "Gửi yêu cầu",
        "approve": "Duyệt",
        "reject": "Từ chối",
        "receive": "Nhận hàng",
        "accept": "Nghiệm thu",
        "handover": "Bàn giao"
      }
    },
    {
      "id": "request-context",
      "type": "context-entity",
      "title": "Dữ liệu liên kết",
      "collection": "workflow-runs",
      "permissions": [
        "data:read"
      ],
      "entityFields": [
        {
          "name": "assetCode",
          "title": "Mã tài sản"
        },
        {
          "name": "location",
          "title": "Vị trí tài sản"
        },
        {
          "name": "status",
          "title": "Trạng thái tài sản"
        }
      ]
    }
  ],
  "transitions": [],
  "workspace": {
    "blocks": [
      {
        "blockId": "my-inbox"
      }
    ],
    "showTransitions": false,
    "home": true,
    "shortcut": {
      "hidden": true
    }
  }
}
