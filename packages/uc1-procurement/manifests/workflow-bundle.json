{
  "format": "latticedx.workflow-bundle",
  "formatVersion": 1,
  "definitions": [
    {
      "id": "procurement-bundle-v1",
      "title": "Quy trình mua sắm và bàn giao tài sản (UC1)",
      "startRole": "employee",
      "initialState": "draft",
      "startFields": {},
      "readerRoles": [
        "procurement:manager",
        "department:warehouse",
        "workflow:sync"
      ],
      "transitions": [
        {
          "id": "submit",
          "from": "draft",
          "to": "submitted",
          "role": "employee",
          "ownerOnly": true,
          "fields": {}
        },
        {
          "id": "approve",
          "from": "submitted",
          "to": "approved",
          "role": "procurement:manager",
          "fields": {}
        },
        {
          "id": "reject",
          "from": "submitted",
          "to": "rejected",
          "role": "procurement:manager",
          "fields": {
            "reason": "text"
          }
        },
        {
          "id": "receive",
          "from": "approved",
          "to": "received",
          "role": "department:warehouse",
          "fields": {
            "receiptAttachmentId": "file"
          }
        },
        {
          "id": "accept",
          "from": "received",
          "to": "accepted",
          "role": "department:warehouse",
          "fields": {
            "acceptanceNote": "text"
          }
        },
        {
          "id": "handover",
          "from": "accepted",
          "to": "handed_over",
          "role": "department:warehouse",
          "fields": {
            "assetId": "text",
            "recipientId": "subject",
            "departmentId": "department",
            "locationId": "location",
            "attachmentId": "file"
          },
          "eventType": "asset.handed_over"
        }
      ]
    }
  ]
}
