                                         "jsCode":  "const request = $input.first().json;\nconst body = request.body;\nconst headers = request.headers ?? {};\nconst errors = [];\n\nfunction isObject(value) {\n  return value !== null \u0026\u0026\n    typeof value === \"object\" \u0026\u0026\n    !Array.isArray(value);\n}\n\nif (!isObject(body)) {\n  return [{\n    json: {\n      valid: false,\n      errors: [\"Body must be a JSON object\"],\n    },\n  }];\n}\n\n// Chỉ nhận title và input.\nconst allowedFields = new Set([\"title\", \"input\"]);\n\nif (Object.keys(body).some(field =\u003e !allowedFields.has(field))) {\n  errors.push(\"Only title and input are accepted\");\n}\n\n// Giữ nguyên title, không tự thay đổi nội dung khi retry.\nif (\n  typeof body.title !== \"string\" ||\n  !body.title.trim() ||\n  [...body.title].length \u003e 200\n) {\n  errors.push(\"title: nonblank string, maximum 200 Unicode characters\");\n}\n\n// Procurement v1 chỉ chấp nhận input rỗng.\nif (\n  body.input !== undefined \u0026\u0026\n  (!isObject(body.input) || Object.keys(body.input).length !== 0)\n) {\n  errors.push(\"input: must be an empty JSON object\");\n}\n\nconst keyHeaders = Object.entries(headers).filter(\n  ([name]) =\u003e name.toLowerCase() === \"idempotency-key\"\n);\n\nconst idempotencyKey = keyHeaders[0]?.[1];\n\nif (\n  keyHeaders.length !== 1 ||\n  typeof idempotencyKey !== \"string\" ||\n  !/^[A-Za-z0-9._:-]{1,128}$/.test(idempotencyKey)\n) {\n  errors.push(\"Idempotency-Key: invalid or missing\");\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    ...(errors.length === 0\n      ? {\n          idempotencyKey,\n          payload: {\n            definitionId: \"procurement\",\n            title: body.title.trim(),\n            input: {},\n          },\n        }\n      : {}),\n  },\n}];"
                                     },
