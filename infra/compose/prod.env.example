# Public example template for infra/compose/prod.yml validation and operator onboarding.
# Copy to an ignored .env.prod file outside Git and replace every CHANGE_ME_* value with cryptographic secrets.

LATTICE_DOMAIN=app.latticedx.example.com
KEYCLOAK_DOMAIN=auth.latticedx.example.com
N8N_DOMAIN=n8n.latticedx.example.com
LATTICE_ALLOWED_ORIGIN=https://app.latticedx.example.com

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PG_SUPERUSER_PASSWORD
LATTICE_DB_PASSWORD=CHANGE_ME_STRONG_LATTICE_APP_PASSWORD
KEYCLOAK_DB_PASSWORD=CHANGE_ME_STRONG_KEYCLOAK_APP_PASSWORD
N8N_DB_PASSWORD=CHANGE_ME_STRONG_N8N_APP_PASSWORD
# PostgreSQL PITR WAL archiving command (archives compressed WAL segments to mounted WAL archive volume)
PG_ARCHIVE_COMMAND=/bin/sh /etc/postgresql/pitr-archive.sh %p %f

NOCOBASE_DB_USER=nocobase
NOCOBASE_DB_PASSWORD=CHANGE_ME_STRONG_NOCOBASE_DB_PASSWORD
NOCOBASE_APP_DB_USER=nocobase_app
NOCOBASE_APP_DB_PASSWORD=CHANGE_ME_STRONG_NOCOBASE_APP_DB_PASSWORD
NOCOBASE_APP_KEY=CHANGE_ME_64HEX_NOCOBASE_APP_KEY
NOCOBASE_ENCRYPTION_FIELD_KEY=CHANGE_ME_64HEX_NOCOBASE_FIELD_KEY

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
RUSTFS_ACCESS_KEY=CHANGE_ME_RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=CHANGE_ME_STRONG_RUSTFS_SECRET_KEY

KEYCLOAK_ADMIN_USER=kc-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_KC_ADMIN_PASSWORD
APISIX_OIDC_CLIENT_SECRET=CHANGE_ME_STRONG_GATEWAY_OIDC_SECRET

DX_NATIVE_FILES_INSTANCE=latticedx-prod
DX_NATIVE_FILES_SECRET=CHANGE_ME_STRONG_NATIVE_FILES_SECRET
FILE_STORAGE_PROVIDER=s3

DX_METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
DX_PG_RLS_SESSION=true
# Optional when running with --profile pdf: DXOS_GOTENBERG_URL=http://gotenberg:3000
DXOS_GOTENBERG_URL=

ORION_MONGO_USER=orion_root
ORION_MONGO_PASSWORD=CHANGE_ME_STRONG_ORION_MONGO_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_STRONG_N8N_ENCRYPTION_KEY
N8N_URL=http://n8n:5678
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
DX_ALLOW_INTERNAL_CONNECTORS=true
DX_INTERNAL_SERVICE_HOSTS=n8n,orion-ld,nodered,mosquitto

# Optional --profile iiot settings
MQTT_ADMIN_USER=ldx_mqtt_admin
MQTT_ADMIN_PASSWORD=CHANGE_ME_STRONG_MQTT_ADMIN_PASSWORD
MQTT_BRIDGE_USER=nodered_bridge
MQTT_BRIDGE_PASSWORD=CHANGE_ME_STRONG_MQTT_BRIDGE_PASSWORD
DX_MQTT_BROKER_HOST=mosquitto
DX_MQTT_BROKER_PORT=1883
DX_NODERED_COMMAND_URL=http://nodered:1880/twin/command
DX_IIOT_INGEST_TOKEN=CHANGE_ME_32HEX_IIOT_INGEST_TOKEN
NODERED_CREDENTIAL_SECRET=CHANGE_ME_32HEX_NODERED_CREDENTIAL_SECRET
NODERED_ADMIN_USER=nodered_admin
NODERED_ADMIN_PASS_HASH=CHANGE_ME_BCRYPT_NODERED_ADMIN_PASS_HASH
