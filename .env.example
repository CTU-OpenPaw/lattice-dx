# Defaults are sufficient for local development. Set these in your shell to override.
API_PORT=4000
WORKER_PORT=4001
API_URL=http://127.0.0.1:4000
WORKER_URL=http://127.0.0.1:4001

# Optional fixed n8n/connector destination; unset keeps outbox pending.
# Compose interpolates shell environment or root .env; pnpm dev uses shell only.
WORKFLOW_EVENT_URL=
WORKFLOW_EVENT_TOKEN=

# Optional server/CLI provider smoke. Copy these into ignored .env.agent locally.
# No provider credentials belong in NEXT_PUBLIC_* variables or browser plugins.
AGENT_PROVIDER=9router
AGENT_BASE_URL=http://localhost:20128/v1
AGENT_API_KEY=
AGENT_MODEL=combo
# One-job CLI: trusted engine/gateway origin and a short-lived worker JWT.
AGENT_ENGINE_URL=http://localhost:8080
AGENT_WORKER_TOKEN=
