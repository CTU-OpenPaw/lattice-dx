      {
        "parameters": {
          "jsCode": "const input = $input.first().json;\nconst body = input.body;\nconst headers = input.headers ?? {};\nconst errors = [];\n\nif (\n  body === null ||\n  typeof body !== \"object\" ||\n  Array.isArray(body)\n) {\n  return [{\n    json: {\n      valid: false,\n      errors: [\"Body must be a JSON object\"],\n    },\n  }];\n}\n\nconst limits = {\n  title: 200,\n  customerName: 2000,\n  deliveryAddress: 2000,\n  sku: 2000,\n};\n\nfor (const [field, maxLength] of Object.entries(limits)) {\n  const value = body[field];\n\n  if (\n    typeof value !== \"string\" ||\n    !value.trim() ||\n    [...value].length > maxLength\n  ) {\n    errors.push(`${field}: required string, maximum ${maxLength} characters`);\n  }\n}\n\nif (\n  !Number.isInteger(body.quantity) ||\n  body.quantity < 1 ||\n  body.quantity > 1000000\n) {\n  errors.push(\"quantity: integer from 1 to 1000000 required\");\n}\n\nif (\n  typeof body.warehouseAssigneeId !== \"string\" ||\n  !body.warehouseAssigneeId.trim() ||\n  body.warehouseAssigneeId.length > 255\n) {\n  errors.push(\"warehouseAssigneeId: non-empty subject required\");\n}\n\nconst key = headers[\"idempotency-key\"];\n\nif (\n  typeof key !== \"string\" ||\n  !/^[A-Za-z0-9._:-]{1,128}$/.test(key)\n) {\n  errors.push(\"Idempotency-Key: invalid or missing\");\n}\n\nconst allowed = new Set([\n  ...Object.keys(limits),\n  \"quantity\",\n  \"warehouseAssigneeId\",\n  \"attachmentId\",\n]);\n\nfor (const field of Object.keys(body)) {\n  if (!allowed.has(field)) {\n    errors.push(`Unsupported field: ${field}`);\n  }\n}\n\nif (\n  body.attachmentId !== undefined &&\n  (\n    typeof body.attachmentId !== \"string\" ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i\n      .test(body.attachmentId)\n  )\n) {\n  errors.push(\"attachmentId: UUID required\");\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    ...(errors.length === 0\n      ? { payload: body, idempotencyKey: key }\n      : {}),\n  },\n}];"
        },
