{
  "name": "lattice-dx", "version": "0.1.0", "private": true, "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0", "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "pnpm --parallel --filter @dx/web --filter @dx/api --filter @dx/agent-worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p solutions/logistics/tsconfig.json",
    "test": "vitest run --maxWorkers=4",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/compose/core.yml up -d --build",
    "docker:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-desktop.ps1 -Mode Start",
    "docker:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-desktop.ps1 -Mode Stop",
    "docker:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-desktop.ps1 -Mode Restart",
    "local:up": "pnpm docker:start && docker --context desktop-linux compose -f infra/compose/core.yml up -d --build && docker --context desktop-linux compose -f infra/compose/nocobase.yml up -d",
    "infra:down": "docker compose -f infra/compose/core.yml down",
    "infra:logs": "docker compose -f infra/compose/core.yml logs --tail 100",
    "nocobase:up": "docker compose -f infra/compose/nocobase.yml up -d",
    "workspace:install": "node scripts/install-workspace.mjs",
    "nocobase:down": "docker compose -f infra/compose/nocobase.yml down",
    "nocobase:logs": "docker compose -f infra/compose/nocobase.yml logs --tail 100",
    "test:nocobase": "node scripts/smoke-nocobase.mjs",
    "test:foundation": "node scripts/smoke-foundation.mjs",
    "test:actions": "node scripts/smoke-actions.mjs",
    "test:create-reliability": "node scripts/smoke-create-reliability.mjs",
    "test:enterprise-data": "node scripts/smoke-enterprise-data.mjs",
    "test:entity-sharing": "node scripts/smoke-entity-sharing.mjs",
    "test:task-lifecycle": "node scripts/smoke-task-lifecycle.mjs",
    "test:entity-query-blocks": "node scripts/smoke-entity-query-blocks.mjs",
    "test:workflow-lifecycle": "node scripts/smoke-workflow-lifecycle.mjs",
    "test:organization-operations": "node scripts/smoke-organization-operations.mjs",
    "test:inbound-events": "node scripts/smoke-inbound-events.mjs",
    "test:enterprise-modules": "node scripts/smoke-enterprise-modules.mjs",
    "test:workflow-timers": "node scripts/smoke-workflow-timers.mjs",
    "test:entity-data-tools": "node scripts/smoke-entity-data-tools.mjs",
    "test:typed-workflow-blocks": "node scripts/smoke-typed-workflow-blocks.mjs",
    "test:directory-concurrency": "node scripts/smoke-directory-concurrency.mjs",
    "test:entity-workflow-context": "node scripts/smoke-entity-workflow-context.mjs",
    "test:entity-events": "node scripts/smoke-entity-events.mjs",
    "test:entity-automations": "node scripts/smoke-entity-automations.mjs",
    "test:private-workflow-blocks": "node scripts/smoke-private-workflow-blocks.mjs",
    "test:module-bindings": "node scripts/smoke-module-bindings.mjs",
    "test:entity-aggregates": "node scripts/smoke-entity-aggregates.mjs",
    "test:report-snapshots": "node scripts/smoke-report-snapshots.mjs",
    "test:file-storage": "node scripts/smoke-file-storage.mjs",
    "test:file-content": "node scripts/smoke-file-content.mjs",
    "test:entity-search": "node scripts/smoke-entity-search.mjs",
    "test:runtime-config": "node scripts/smoke-runtime-config.mjs",
    "test:runtime-operations": "node scripts/smoke-runtime-operations.mjs",
    "test:full-recovery": "node scripts/smoke-full-recovery.mjs",
    "test:enterprise-composition": "node scripts/smoke-enterprise-composition.mjs",
    "integration:seed": "node scripts/seed-team-integration.mjs",
    "test:team-integration": "node scripts/smoke-team-integration.mjs",
    "backup:core": "node scripts/backup-core.mjs backup",
    "backup:rehearse": "node scripts/backup-core.mjs rehearse",
    "backup:full": "node scripts/full-backup-core.mjs backup",
    "backup:rehearse-full": "node scripts/full-backup-core.mjs rehearse",
    "workflow:seed-local": "node scripts/seed-workflow-demo.mjs",
    "directory:sync-local": "node scripts/sync-local-directory.mjs",
    "test:logistics": "node scripts/smoke-logistics.mjs",
    "test:workflows": "node scripts/smoke-workflows.mjs",
    "test:workflow-studio": "node scripts/smoke-workflow-studio.mjs",
    "test:workflow-blocks": "node scripts/smoke-workflow-blocks.mjs",
    "test:workflow-completion": "node scripts/smoke-workflow-completion.mjs",
    "test:workflow-bundles": "node scripts/smoke-workflow-bundles.mjs",
    "test:record-links": "node scripts/smoke-record-links.mjs",
    "nocobase:bridge:install": "node scripts/install-nocobase-bridge.mjs",
    "test:nocobase:bridge": "node scripts/smoke-nocobase-bridge.mjs",
    "test:nocobase:form": "node scripts/smoke-lattice-form.mjs",
    "test:scanner-outage": "node scripts/smoke-scanner-outage.mjs",
    "identity:sync-local": "node scripts/sync-local-realm.mjs",
    "test:infra": "node scripts/smoke-core.mjs"
  },
  "devDependencies": { "typescript": "7.0.2", "tsx": "4.23.15", "vitest": "5.0.3", "@types/node": "26.6.4" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
