{
  "name": "lattice-dx", "version": "0.1.0", "private": true, "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0", "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "pnpm --parallel --filter @dx/web --filter @dx/api --filter @dx/agent-worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/compose/core.yml up -d --build",
    "infra:down": "docker compose -f infra/compose/core.yml down",
    "infra:logs": "docker compose -f infra/compose/core.yml logs --tail 100",
    "nocobase:up": "docker compose -f infra/compose/nocobase.yml up -d",
    "nocobase:down": "docker compose -f infra/compose/nocobase.yml down",
    "nocobase:logs": "docker compose -f infra/compose/nocobase.yml logs --tail 100",
    "test:nocobase": "node scripts/smoke-nocobase.mjs",
    "test:foundation": "node scripts/smoke-foundation.mjs",
    "identity:sync-local": "node scripts/sync-local-realm.mjs",
    "test:infra": "node scripts/smoke-core.mjs"
  },
  "devDependencies": { "typescript": "7.0.2", "tsx": "4.23.15", "vitest": "5.0.3", "@types/node": "26.6.4" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
